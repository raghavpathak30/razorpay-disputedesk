# Copy to .env and fill in real values. Never commit .env.

# Razorpay test-mode API credentials. "Test mode" is determined by using a
# rzp_test_-prefixed key pair here, not by a different API host.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional - defaults to Razorpay's real API host if unset. Verified against
# https://razorpay.com/docs/api/disputes/ on 2026-09-01.
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# Groq API key (https://console.groq.com/keys) for the LLM used to draft
# evidence text and normalise free text (evidence/ only, per SPEC.md §2).
LLM_API_KEY=

# Groq's OpenAI-compatible chat completions endpoint.
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions

# openai/gpt-oss-20b: verified against console.groq.com/docs/models on
# 2026-08-31 as a current Groq production model (not preview), and the
# model Groq's own deprecation notice recommends migrating free/developer
# usage to. Chosen deliberately small for this project's two LLM tasks
# (drafting a short letter, normalising free text into typed fields) - see
# the 2026-08-31 "LLM provider: Groq" entry in DECISIONS.md. If this model
# is later deprecated, check https://console.groq.com/docs/models for its
# current replacement before changing this value.
LLM_MODEL=openai/gpt-oss-20b

# SQLAlchemy database URL, e.g. sqlite:///./disputedesk.db
DATABASE_URL=
